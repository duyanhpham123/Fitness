# Copy file này thành .env (đã gitignore) rồi điền giá trị, dùng cho:
#   docker compose --profile app up -d --build

# Mật khẩu root của MySQL chạy trong Docker (tự đặt, không phải MySQL trên máy)
DB_PASSWORD=

# Chuỗi ngẫu nhiên dài ít nhất 32 ký tự, dùng ký JWT. Tạo nhanh: openssl rand -base64 48
JWT_SECRET=

# Trang frontend (CORS + trang kết quả thanh toán)
APP_FE_BASE_URL=http://127.0.0.1:5500

# VNPay sandbox (để trống nếu chưa có)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

# true = trả mã OTP trong response (chỉ dùng khi thử nghiệm)
APP_OTP_EXPOSE_IN_RESPONSE=true
