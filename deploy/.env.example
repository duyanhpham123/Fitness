# =====================================================================
#  Cấu hình production. Copy thành .env (KHÔNG commit file .env) rồi điền giá trị.
#  Sinh chuỗi ngẫu nhiên:  openssl rand -base64 32
# =====================================================================

# Tên miền đã trỏ về IP của VPS (không có https://)
DOMAIN=fitness.example.com

# ----- Database / Redis (tự đặt, mỗi giá trị 1 chuỗi ngẫu nhiên dài) -----
DB_ROOT_PASSWORD=
DB_PASSWORD=
REDIS_PASSWORD=

# Khóa ký JWT, ít nhất 32 ký tự. Đổi khóa này = mọi người phải đăng nhập lại
JWT_SECRET=

# ----- Tài khoản ADMIN đầu tiên -----
# Chỉ dùng lần đầu (khi chưa có admin). Mật khẩu ít nhất 12 ký tự.
# Đăng nhập xong: đổi mật khẩu trong trang Hồ sơ rồi XÓA 2 dòng này và chạy lại "up -d".
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ----- Email (bắt buộc: gửi OTP đăng ký / quên mật khẩu, thông báo) -----
# Nên dùng dịch vụ gửi email (Brevo, Amazon SES, Mailgun...) thay vì Gmail cá nhân
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Địa chỉ người gửi, phải được xác minh với dịch vụ email
MAIL_FROM=no-reply@fitness.example.com

# ----- VNPay (để trống nếu chưa có hợp đồng merchant) -----
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Sandbox: https://sandbox.vnpayment.vn/paymentv2/vpcpay.html   Thật: https://pay.vnpay.vn/vpcpay.html
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# Số ngày giữ bản sao lưu database
BACKUP_KEEP_DAYS=14
